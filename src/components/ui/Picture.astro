---
/**
 * Responsive image from /public/images/<name>-800.webp & -1600.webp.
 * Lazy by default; pass `eager` for above-the-fold images.
 */
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  width?: number;
  height?: number;
}

const { name, alt, sizes = '(min-width: 1024px) 50vw, 100vw', eager = false, class: className, width = 800, height = 533 } = Astro.props;
const base = `/images/${name}`;
---

<img
  class={className}
  src={`${base}-800.webp`}
  srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
/>
